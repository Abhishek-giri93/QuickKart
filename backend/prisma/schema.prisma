// ─────────────────────────────────────────────────────────────────────────────
// QuickKart — Prisma Schema
// Database: PostgreSQL
// ORM: Prisma
//
// Entities defined here:
//   User, CustomerProfile, SellerProfile, Store, DeliveryPartner,
//   Address, Category, Product, ProductImage, Inventory,
//   Cart, CartItem, Order, OrderItem, Delivery,
//   Payment, Transaction, Refund, Coupon, Review,
//   Notification, SupportTicket
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  SELLER
  DELIVERY_PARTNER
  ADMIN
}

enum StoreStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  REJECTED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  PREPARING
  READY
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  ACCEPTED
  PICKED_UP
  DELIVERED
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

enum TransactionType {
  PAYMENT
  REFUND
  COMMISSION
  SETTLEMENT
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum NotificationType {
  ORDER_UPDATE
  DELIVERY_UPDATE
  PAYMENT_UPDATE
  PROMOTION
  SYSTEM
}

enum VehicleType {
  BICYCLE
  MOTORCYCLE
  CAR
  OTHER
}

// ─────────────────────────────────────────────────────────────────────────────
// USER — Base authentication entity for all roles
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  phone         String   @unique
  passwordHash  String
  role          Role
  isActive      Boolean  @default(true)
  isVerified    Boolean  @default(false)
  refreshToken  String?  // Hashed refresh token stored server-side
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  customerProfile  CustomerProfile?
  sellerProfile    SellerProfile?
  deliveryPartner  DeliveryPartner?
  notifications    Notification[]
  supportTickets   SupportTicket[]

  @@index([email])
  @@index([phone])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// CUSTOMER PROFILE
// ─────────────────────────────────────────────────────────────────────────────

model CustomerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  firstName   String
  lastName    String
  avatarUrl   String?
  dateOfBirth DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses Address[]
  cart      Cart?
  orders    Order[]
  reviews   Review[]

  @@map("customer_profiles")
}

// ─────────────────────────────────────────────────────────────────────────────
// SELLER PROFILE
// ─────────────────────────────────────────────────────────────────────────────

model SellerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  firstName       String
  lastName        String
  businessName    String
  gstNumber       String?
  panNumber       String?
  avatarUrl       String?
  bankAccountNo   String?
  bankIfsc        String?
  isKycVerified   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  stores Store[]

  @@map("seller_profiles")
}

// ─────────────────────────────────────────────────────────────────────────────
// STORE
// ─────────────────────────────────────────────────────────────────────────────

model Store {
  id              String      @id @default(uuid())
  sellerProfileId String
  name            String
  description     String?
  coverImageUrl   String?
  logoUrl         String?
  phone           String
  email           String?
  addressLine     String
  city            String
  state           String
  pincode         String
  latitude        Decimal     @db.Decimal(10, 8)
  longitude       Decimal     @db.Decimal(11, 8)
  status          StoreStatus @default(PENDING_VERIFICATION)
  isOpen          Boolean     @default(false)
  openingTime     String?     // "09:00"
  closingTime     String?     // "22:00"
  avgRating       Decimal     @default(0) @db.Decimal(3, 2)
  totalRatings    Int         @default(0)
  commissionRate  Decimal     @default(10.00) @db.Decimal(5, 2) // Platform commission %
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  products      Product[]
  orders        Order[]
  reviews       Review[]

  @@index([sellerProfileId])
  @@index([city, status])
  @@index([latitude, longitude])
  @@map("stores")
}

// ─────────────────────────────────────────────────────────────────────────────
// DELIVERY PARTNER
// ─────────────────────────────────────────────────────────────────────────────

model DeliveryPartner {
  id              String      @id @default(uuid())
  userId          String      @unique
  firstName       String
  lastName        String
  avatarUrl       String?
  vehicleType     VehicleType
  vehicleNumber   String
  licenseNumber   String
  isOnline        Boolean     @default(false)
  isVerified      Boolean     @default(false)
  currentLat      Decimal?    @db.Decimal(10, 8)
  currentLng      Decimal?    @db.Decimal(11, 8)
  avgRating       Decimal     @default(0) @db.Decimal(3, 2)
  totalRatings    Int         @default(0)
  totalDeliveries Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries Delivery[]
  reviews    Review[]

  @@index([isOnline, isVerified])
  @@map("delivery_partners")
}

// ─────────────────────────────────────────────────────────────────────────────
// ADDRESS
// ─────────────────────────────────────────────────────────────────────────────

model Address {
  id                String   @id @default(uuid())
  customerProfileId String
  label             String   // "Home", "Work", "Other"
  recipientName     String
  recipientPhone    String
  addressLine1      String
  addressLine2      String?
  landmark          String?
  city              String
  state             String
  pincode           String
  latitude          Decimal? @db.Decimal(10, 8)
  longitude         Decimal? @db.Decimal(11, 8)
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  orders          Order[]

  @@index([customerProfileId])
  @@map("addresses")
}

// ─────────────────────────────────────────────────────────────────────────────
// CATEGORY
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  imageUrl    String?
  isActive    Boolean    @default(true)
  parentId    String?    // Supports subcategories
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Self-relation for nested categories
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId])
  @@index([slug])
  @@map("categories")
}

// ─────────────────────────────────────────────────────────────────────────────
// PRODUCT
// ─────────────────────────────────────────────────────────────────────────────

model Product {
  id              String   @id @default(uuid())
  storeId         String
  categoryId      String
  name            String
  slug            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  discountedPrice Decimal? @db.Decimal(10, 2)
  unit            String?  // "kg", "litre", "piece", "dozen"
  isAvailable     Boolean  @default(true)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category      Category       @relation(fields: [categoryId], references: [id])
  images        ProductImage[]
  inventory     Inventory?
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([categoryId])
  @@index([isAvailable, isActive])
  @@map("products")
}

// ─────────────────────────────────────────────────────────────────────────────
// PRODUCT IMAGE
// ─────────────────────────────────────────────────────────────────────────────

model ProductImage {
  id          String   @id @default(uuid())
  productId   String
  imageUrl    String
  publicId    String?  // Cloudinary public ID for deletion
  isPrimary   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ─────────────────────────────────────────────────────────────────────────────
// INVENTORY
// ─────────────────────────────────────────────────────────────────────────────

model Inventory {
  id            String   @id @default(uuid())
  productId     String   @unique
  quantity      Int      @default(0)
  lowStockAlert Int      @default(10) // Alert when stock drops below this
  updatedAt     DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

// ─────────────────────────────────────────────────────────────────────────────
// CART
// ─────────────────────────────────────────────────────────────────────────────

model Cart {
  id                String   @id @default(uuid())
  customerProfileId String   @unique  // One active cart per customer
  storeId           String?  // Cart is locked to one store
  couponId          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  items           CartItem[]
  coupon          Coupon?         @relation(fields: [couponId], references: [id])

  @@map("carts")
}

// ─────────────────────────────────────────────────────────────────────────────
// CART ITEM
// ─────────────────────────────────────────────────────────────────────────────

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// ORDER
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id                String      @id @default(uuid())
  orderNumber       String      @unique  // Human-readable (QK-2026-00001)
  customerProfileId String
  storeId           String
  addressId         String
  couponId          String?
  status            OrderStatus @default(PENDING)
  subtotal          Decimal     @db.Decimal(10, 2)
  discountAmount    Decimal     @default(0) @db.Decimal(10, 2)
  deliveryFee       Decimal     @default(0) @db.Decimal(10, 2)
  taxAmount         Decimal     @default(0) @db.Decimal(10, 2)
  totalAmount       Decimal     @db.Decimal(10, 2)
  specialInstructions String?
  scheduledAt       DateTime?   // For scheduled deliveries
  acceptedAt        DateTime?
  readyAt           DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  cancellationReason String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relations
  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id])
  store           Store           @relation(fields: [storeId], references: [id])
  address         Address         @relation(fields: [addressId], references: [id])
  coupon          Coupon?         @relation(fields: [couponId], references: [id])
  items           OrderItem[]
  delivery        Delivery?
  payment         Payment?
  reviews         Review[]

  @@index([customerProfileId])
  @@index([storeId])
  @@index([status])
  @@index([orderNumber])
  @@map("orders")
}

// ─────────────────────────────────────────────────────────────────────────────
// ORDER ITEM — Snapshot of product at order time (price must not change later)
// ─────────────────────────────────────────────────────────────────────────────

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String
  productName String  // Snapshot: product name at order time
  productUnit String? // Snapshot: unit at order time
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2) // Snapshot: price at order time
  totalPrice  Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// DELIVERY
// ─────────────────────────────────────────────────────────────────────────────

model Delivery {
  id                String         @id @default(uuid())
  orderId           String         @unique
  deliveryPartnerId String?
  status            DeliveryStatus @default(PENDING)
  isSelfDelivery    Boolean        @default(false) // Seller handles own delivery
  otp               String?        // 4-digit OTP for delivery confirmation
  otpVerifiedAt     DateTime?
  pickedUpAt        DateTime?
  deliveredAt       DateTime?
  deliveryNotes     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order           Order            @relation(fields: [orderId], references: [id])
  deliveryPartner DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id])

  @@index([deliveryPartnerId])
  @@index([status])
  @@map("deliveries")
}

// ─────────────────────────────────────────────────────────────────────────────
// PAYMENT
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id               String        @id @default(uuid())
  orderId          String        @unique
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  amount           Decimal       @db.Decimal(10, 2)
  currency         String        @default("INR")
  razorpayOrderId  String?       // Razorpay order ID
  razorpayPaymentId String?      // Razorpay payment ID (after success)
  razorpaySignature String?      // For verification
  idempotencyKey   String        @unique // Prevent duplicate payments
  paidAt           DateTime?
  failureReason    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  order        Order         @relation(fields: [orderId], references: [id])
  transactions Transaction[]
  refunds      Refund[]

  @@index([status])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// TRANSACTION — Complete audit trail of all money movements
// ─────────────────────────────────────────────────────────────────────────────

model Transaction {
  id          String          @id @default(uuid())
  paymentId   String
  type        TransactionType
  amount      Decimal         @db.Decimal(10, 2)
  description String?
  metadata    Json?           // Extra data (e.g. Razorpay response)
  createdAt   DateTime        @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("transactions")
}

// ─────────────────────────────────────────────────────────────────────────────
// REFUND
// ─────────────────────────────────────────────────────────────────────────────

model Refund {
  id               String       @id @default(uuid())
  paymentId        String
  amount           Decimal      @db.Decimal(10, 2)
  reason           String
  status           RefundStatus @default(REQUESTED)
  razorpayRefundId String?
  processedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("refunds")
}

// ─────────────────────────────────────────────────────────────────────────────
// COUPON
// ─────────────────────────────────────────────────────────────────────────────

model Coupon {
  id              String    @id @default(uuid())
  code            String    @unique
  description     String?
  discountPercent Decimal?  @db.Decimal(5, 2)  // e.g. 10.00 = 10%
  discountAmount  Decimal?  @db.Decimal(10, 2) // Flat discount
  minOrderAmount  Decimal?  @db.Decimal(10, 2) // Minimum order to apply
  maxDiscount     Decimal?  @db.Decimal(10, 2) // Cap on percentage discounts
  usageLimit      Int?      // Total uses allowed (null = unlimited)
  usedCount       Int       @default(0)
  perUserLimit    Int       @default(1)         // Times one user can use it
  isActive        Boolean   @default(true)
  validFrom       DateTime
  validUntil      DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  carts  Cart[]
  orders Order[]

  @@index([code])
  @@index([isActive, validFrom, validUntil])
  @@map("coupons")
}

// ─────────────────────────────────────────────────────────────────────────────
// REVIEW
// ─────────────────────────────────────────────────────────────────────────────

model Review {
  id                String   @id @default(uuid())
  orderId           String
  customerProfileId String
  storeId           String?
  deliveryPartnerId String?
  storeRating       Int?     // 1-5
  deliveryRating    Int?     // 1-5
  storeComment      String?
  deliveryComment   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  order           Order            @relation(fields: [orderId], references: [id])
  customerProfile CustomerProfile  @relation(fields: [customerProfileId], references: [id])
  store           Store?           @relation(fields: [storeId], references: [id])
  deliveryPartner DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id])

  @@unique([orderId, customerProfileId]) // One review per order per customer
  @@index([storeId])
  @@index([deliveryPartnerId])
  @@map("reviews")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATION
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?            // Extra payload (e.g. orderId, screen to open)
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// SUPPORT TICKET
// ─────────────────────────────────────────────────────────────────────────────

model SupportTicket {
  id          String       @id @default(uuid())
  userId      String
  orderId     String?
  subject     String
  description String
  status      TicketStatus @default(OPEN)
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

